# No credentials needed for the synthetic demo. npm run setup creates personal settings.
APP_MODE=demo
PORT=4310
BUDGET_CURRENCY=USD
# Personal mode requires generated values. Never reuse production secrets.
APP_PASSWORD=
VAULT_KEY=
# Optional Plaid; sandbox is the default. Production also needs explicit opt-in.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_COUNTRY_CODES=US
ALLOW_LIVE_PLAID=false
# Optional SnapTrade; account credentials stay on the server.
SNAPTRADE_AUTH_MODE=personal
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# Optional locally hosted model; no cloud AI endpoint is supported by default.
AI_PROVIDER=disabled
OLLAMA_MODEL=
