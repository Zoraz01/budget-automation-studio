# No credentials needed for the synthetic demo. npm run setup creates personal settings.
APP_MODE=demo
PORT=4310
BUDGET_CURRENCY=USD
# Personal mode requires generated values. Never reuse production secrets.
APP_PASSWORD=
VAULT_KEY=
# Optional Plaid; sandbox is the default. Production also needs explicit opt-in.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_COUNTRY_CODES=US
ALLOW_LIVE_PLAID=false
# Optional SnapTrade; account credentials stay on the server.
SNAPTRADE_AUTH_MODE=personal
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# Optional AI: npm run setup:ai asks for a provider and hidden key.
# disabled | openai | anthropic | gemini | ollama. Demo always disables AI.
AI_PROVIDER=disabled
# Server-side key for the selected cloud provider. Never put it in web/.
AI_API_KEY=
# Optional override; cloud defaults are selected automatically.
AI_MODEL=
# Existing Ollama settings remain supported. AI_MODEL takes precedence.
OLLAMA_MODEL=
