{
  "name": "budget-automation-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first budget dashboard with Plaid, SnapTrade and your choice of cloud or local AI.",
  "license": "MIT",
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --watch --env-file-if-exists=.env server/index.mjs",
    "setup": "node scripts/setup.mjs",
    "test": "node --test test/*.test.mjs",
    "check:release": "node scripts/check-release.mjs",
    "format": "prettier --write \"server/**/*.mjs\" \"web/*.{js,css,html}\" \"scripts/*.mjs\" \"test/*.mjs\" \"docs/design/*.{js,css,html}\"",
    "check:format": "prettier --check \"server/**/*.mjs\" \"web/*.{js,css,html}\" \"scripts/*.mjs\" \"test/*.mjs\" \"docs/design/*.{js,css,html}\"",
    "setup:ai": "node scripts/setup-ai.mjs"
  },
  "dependencies": {
    "snaptrade-typescript-sdk": "12.2.8"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
